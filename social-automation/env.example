# ============================================================================
# Skyline social automation — LOCAL env reference (committed; contains NO secrets)
# ============================================================================
# This is Skyline's OWN instance. Its secrets are SEPARATE from the firm's — a
# Skyline Airtable base, Skyline's WhatsApp/Gmail, Skyline's Meta creds. Never
# reuse the firm's base or paste the firm's tokens here (repo-split rule).
#
# Copy the lines you need into a plaintext `.env` inside this folder
# (social-automation/.env — gitignored), paste real values, then ENCRYPT it:
#
#   $env:SECRETS_PASSPHRASE = "a strong passphrase you keep out of the repo"
#   node automation/secrets.js encrypt     # .env -> .env.enc
#   Remove-Item .env                        # delete the plaintext
#
# From then on, set SECRETS_PASSPHRASE in your shell and the CLIs auto-decrypt
# .env.enc in memory (they never write the plaintext back to disk). Platform
# secrets (Vercel) always win — the loader never overrides an already-set var.
# ----------------------------------------------------------------------------

# --- The client ---
SOCIAL_CLIENT=skyline           # the id registered in automation/clients.js
ANTHROPIC_API_KEY=              # for the generate + SMM/QA/PR agents

# --- Airtable (Skyline's OWN persistent queue) ---
# Create a SEPARATE Airtable base for Skyline (do NOT point at the firm base).
# The Queue table needs the same columns as the firm base, INCLUDING ImageSource
# (long text) + SourceMessageId (single line). See automation/verify-live.js.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# AIRTABLE_QUEUE_TABLE=Queue
# AIRTABLE_RUNS_TABLE=Runs

# --- Approvals over WhatsApp (Skyline's own number/app) ---
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_TO=15551234567       # the approver's number (digits, country code, no +)
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=          # the WhatsApp app's App Secret (verifies inbound webhook)

# --- Gmail intake (Skyline's own mailbox) ---
# GMAIL_USER=info@skylinetravelplanner.com
# GMAIL_ALLOWED_SENDERS=supplier@example.com   # ONLY these senders can seed a post
# GMAIL_SINCE_DAYS=2                            # daily cron window (default 14; 2 is plenty)
# GMAIL_MAX_FETCH=40
# Auth — pick ONE (OAuth preferred, app-password fallback):
# GMAIL_APP_PASSWORD=                           # 16 letters, no spaces
# GMAIL_OAUTH_KEY_B64=                          # base64 service-account JSON (SENSITIVE)
# GMAIL_OAUTH_SUBJECT=info@skylinetravelplanner.com

# --- Image hosting (Skyline's own Vercel Blob store) ---
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx      # auto-injected by Vercel when a store is connected

# --- Publishing (Skyline's Meta account) ---
# SOCIAL_LIVE=                  # leave empty; set to "true" ONLY when going live
# Prefer SKYLINE_* creds; if unset, clients.js falls back to bare META_* (the firm
# site publishes Skyline under META_* today — same IG/Page account).
# SKYLINE_PAGE_ID=437743929683019
# SKYLINE_IG_USER_ID=17841404608201511
# SKYLINE_PAGE_TOKEN=
# META_PAGE_ID=437743929683019
# META_IG_USER_ID=17841404608201511
# META_PAGE_TOKEN=

# --- Cron auth (Vercel) ---
# CRON_SECRET=                  # guards /api/cron-prep + /api/cron-publish
